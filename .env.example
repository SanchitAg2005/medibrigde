# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database Configuration
# Set USE_SQLITE=True to bypass PostgreSQL and use local SQLite database fallback (db.sqlite3)
USE_SQLITE=False
DB_NAME=hms_db
DB_USER=hms_user
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=db
DB_PORT=5432

# Google Calendar Integration (OAuth2 Web Client Credentials)
# These credentials can be obtained from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback/
OAUTHLIB_INSECURE_TRANSPORT=1

# Local Serverless Email Service Endpoint (Offline Node Daemon)
EMAIL_SERVICE_URL=http://serverless:3000/dev/send-email

# SMTP Configuration (Mailpit Locally, or Production Provider)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@hospital.local
